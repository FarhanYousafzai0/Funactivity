# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.

# Turso database. Leave empty locally to use file:local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Password for /admin (the mentor who scores pitches).
ADMIN_PASSWORD=

# Random string used to sign the profile and admin cookies. Required on Vercel.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
